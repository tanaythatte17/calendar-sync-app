{
  "name": "calendar-sync-backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:coverage": "vitest run --config vitest.config.js --coverage",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "calendar-sync",
    "google-calendar",
    "microsoft-outlook",
    "oauth",
    "sse",
    "bullmq"
  ],
  "author": "Tanay Thatte",
  "license": "MIT",
  "description": "Node.js/Express backend that synchronizes Google Calendar and Microsoft Outlook events in real time via OAuth 2.0, webhooks, and Server-Sent Events.",
  "dependencies": {
    "agenda": "^5.0.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^150.0.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.16.0",
    "nodemailer": "^7.0.11",
    "uuid": "^11.1.0",
    "windows-iana": "^5.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
